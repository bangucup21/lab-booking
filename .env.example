APP_NAME="Lab Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://lab-booking.test

# Set ke false di production
DEBUGBAR_ENABLED=false
TELESCOPE_ENABLED=false

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─────────────────────────────
# Database — MySQL
# ─────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lab_booking
DB_USERNAME=root
DB_PASSWORD=

# ─────────────────────────────
# Cache, Session, Queue
# ─────────────────────────────
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ─────────────────────────────
# Mail (opsional)
# ─────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────
# Reverb WebSocket
# Isi jika menggunakan fitur real-time (broadcast booking)
# Kosongkan / set BROADCAST_DRIVER=log untuk disable
# ─────────────────────────────
REVERB_APP_ID=lab-booking
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_REVERB_PATH=""
