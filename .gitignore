# ══════════════════════════════════════════════════════════════
#  .gitignore — Lab Management System
#  Laravel monolith (Blade + Vite)
# ══════════════════════════════════════════════════════════════

# ─── Laravel ─────────────────────────────────────────────────
/vendor
/node_modules
/public/hot
/public/storage
/storage/*.key
.phpunit.result.cache
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log

# ─── Environment & Secrets ───────────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem

# ─── Vite Build Output ───────────────────────────────────────
/public/build

# ─── Storage uploads (runtime, bukan source code) ────────────
/storage/app/public
/storage/framework/cache
/storage/framework/sessions
/storage/framework/views
/storage/logs

# ─── IDE & OS ────────────────────────────────────────────────
/.idea
/.vscode
.DS_Store
Thumbs.db
desktop.ini

# ─── Logs & Bootstrap Cache ──────────────────────────────────
*.log
/bootstrap/cache/*.php

# ─── Docker override (lokal saja) ────────────────────────────
docker-compose.override.yml
